{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pocket",
  "version": "0.1.0",
  "identifier": "app.pocket.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pocket",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": true
      },
      {
        "label": "quick-capture",
        "title": "Pocket Capture",
        "width": 620,
        "height": 148,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data:; media-src 'self' http://voice.localhost https://voice.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
